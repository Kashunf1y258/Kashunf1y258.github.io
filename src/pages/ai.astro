---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Features | Kashunf1y258" description="AI-powered features coming soon to enhance your experience">
  <div class="ai-page">
    <h1>AI Features Coming Soon</h1>
    <p class="intro">We're working on integrating AI capabilities to enhance your experience.</p>
    
    <h2>Planned Features</h2>
    <ul class="features">
      <li>
        <strong>AI Assistant:</strong> Chat with an AI to get help with content
      </li>
      <li>
        <strong>Smart Search:</strong> AI-powered semantic search across articles
      </li>
      <li>
        <strong>Content Suggestions:</strong> AI recommendations for related content
      </li>
      <li>
        <strong>Code Explanation:</strong> AI-powered code explanations in tutorials
      </li>
    </ul>
    
    <p class="cta">Stay tuned for updates!</p>
  </div>
</Layout>

<style>
  .ai-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .intro {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .features {
    list-style: none;
    padding: 0;
  }

  .features li {
    padding: 1rem;
    margin-bottom: 0.75rem;
    background: var(--color-bg-secondary);
    border-radius: 0.5rem;
    border-left: 3px solid var(--color-accent);
  }

  .features li strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .cta {
    margin-top: 2rem;
    font-size: 1.1rem;
    color: var(--color-text-secondary);
  }
</style>
