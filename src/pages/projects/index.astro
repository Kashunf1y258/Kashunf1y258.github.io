---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getCollection('projects');
const statuses = ['all', 'active', 'completed', 'archived'] as const;

const activeStatus = Astro.url.searchParams.get('status') || 'all';
const filteredProjects = activeStatus === 'all'
	? projects
	: projects.filter((p) => p.data.status === activeStatus);
---

<Layout title="项目" description="我的项目作品集">
	<section>
		<h1>项目</h1>
		
		<nav class="filters">
			{statuses.map((status) => (
				<a
					href={status === 'all' ? '/projects/' : `/projects/?status=${status}`}
					class:list={['filter-btn', { active: activeStatus === status }]}
				>
					{status === 'all' ? '全部' : status === 'active' ? '进行中' : status === 'completed' ? '已完成' : '已归档'}
				</a>
			))}
		</nav>

		<div class="project-grid">
			{filteredProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>

		{filteredProjects.length === 0 && (
			<p class="empty">没有找到相关项目。</p>
		)}
	</section>
</Layout>

<style>
	section {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	h1 {
		text-align: center;
		margin-bottom: 2rem;
	}
	.filters {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}
	.filter-btn {
		padding: 0.5rem 1rem;
		border-radius: 4px;
		text-decoration: none;
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
		border: 1px solid rgb(var(--gray));
		transition: all 0.2s ease;
	}
	.filter-btn:hover {
		background: rgb(var(--accent));
		color: white;
		border-color: rgb(var(--accent));
	}
	.filter-btn.active {
		background: rgb(var(--accent));
		color: white;
		border-color: rgb(var(--accent));
	}
	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
	}
	.empty {
		text-align: center;
		color: rgb(var(--gray-dark));
		padding: 3rem;
	}
	@media (max-width: 720px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
