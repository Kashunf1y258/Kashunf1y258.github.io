---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('blog', (p) => !p.data.draft);
const recentPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 2);
---

<Layout title="Home">
	<section class="hero">
		<h1>Developer & Creator</h1>
		<p class="tagline">Building modern web experiences with passion and precision.</p>
		<div class="hero-links">
			<a href="/blog" class="button">Read Blog</a>
			<a href="/projects" class="button secondary">View Projects</a>
		</div>
	</section>

	<section class="recent-posts">
		<h2>Recent Posts</h2>
		<div class="post-grid">
			{recentPosts.map((post) => (
				<article class="post-card">
					<a href={`/blog/${post.id}/`}>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
						<time>{post.data.pubDate.toLocaleDateString()}</time>
					</a>
				</article>
			))}
		</div>
		<a href="/blog" class="view-all">View all posts →</a>
	</section>

	<section class="featured-projects">
		<h2>Featured Projects</h2>
		<div class="project-grid">
			{featuredProjects.map((project) => (
				<article class="project-card">
					<a href={`/projects/${project.id}/`}>
						<h3>{project.data.title}</h3>
						<p>{project.data.description}</p>
						<span class="status">{project.data.status || 'active'}</span>
					</a>
				</article>
			))}
		</div>
		<a href="/projects" class="view-all">View all projects →</a>
	</section>

	<section class="about-preview">
		<h2>About Me</h2>
		<p>A passionate developer focused on building modern, accessible web experiences. Check out my <a href="/about">full bio</a>.</p>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 4rem 1rem;
	}
	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}
	.tagline {
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		margin-bottom: 2rem;
	}
	.hero-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.button {
		padding: 0.75rem 1.5rem;
		background: var(--color-primary);
		color: white;
		border-radius: 0.5rem;
		text-decoration: none;
	}
	.button.secondary {
		background: transparent;
		border: 2px solid var(--color-primary);
		color: var(--color-primary);
	}
	section {
		padding: 3rem 1rem;
		max-width: 1200px;
		margin: 0 auto;
	}
	.post-grid, .project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin: 2rem 0;
	}
	.post-card, .project-card {
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
	}
	.post-card a, .project-card a {
		text-decoration: none;
		color: inherit;
	}
	.view-all {
		display: inline-block;
		margin-top: 1rem;
		color: var(--color-primary);
	}
	.status {
		display: inline-block;
		padding: 0.25rem 0.5rem;
		background: var(--color-accent);
		border-radius: 0.25rem;
		font-size: 0.875rem;
	}
	.about-preview {
		text-align: center;
		padding-bottom: 4rem;
	}
	.about-preview a {
		color: var(--color-primary);
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 2rem;
		}
		.tagline {
			font-size: 1rem;
		}
		section {
			padding: 2rem 1rem;
		}
	}
</style>
