---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const statusConfig: Record<string, { label: string; class: string }> = {
	active: { label: '进行中', class: 'status-active' },
	completed: { label: '已完成', class: 'status-completed' },
	archived: { label: '已归档', class: 'status-archived' },
};

const status = statusConfig[project.data.status ?? 'active'] || statusConfig.active;
---

<article class="card project-card">
	<a href={`/projects/${project.id}/`} class="card-link">
		{project.data.heroImage && (
			<div class="card-image">
				<img
					src={typeof project.data.heroImage === 'string' ? project.data.heroImage : project.data.heroImage.src}
					alt=""
					width="720"
					height="400"
					loading="lazy"
				/>
			</div>
		)}
		<div class="card-content">
			<div class="card-header">
				<h3 class="card-title">{project.data.title}</h3>
				<span class:list={['status', status.class]}>{status.label}</span>
			</div>
			<p class="card-description">{project.data.description}</p>
			
			<div class="card-tech">
				{project.data.tech && project.data.tech.slice(0, 3).map((t: string) => (
					<span class="tag tech-tag">{t}</span>
				))}
				{project.data.tech && project.data.tech.length > 3 && (
					<span class="tag tech-more">+{project.data.tech.length - 3}</span>
				)}
			</div>
			
			<div class="card-links">
				{project.data.github && (
					<span class="card-link-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
						源码
					</span>
				)}
				{project.data.demo && (
					<span class="card-link-item demo">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
							<polyline points="15 3 21 3 21 9"></polyline>
							<line x1="10" y1="14" x2="21" y2="3"></line>
						</svg>
						演示
					</span>
				)}
			</div>
		</div>
	</a>
</article>

<style>
	.project-card {
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 0; /* Override */
	}

	.card-image {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-bottom: 1px solid var(--color-border);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.project-card:hover .card-image img {
		transform: scale(1.03);
	}

	.card-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: var(--space-5);
	}

	.card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
	}

	.card-description {
		flex: 1;
		margin: 0 0 var(--space-4);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tech {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}

	.tech-more {
		background: transparent;
		border: 1px dashed var(--color-border);
	}

	.card-links {
		display: flex;
		gap: var(--space-4);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
		margin-top: auto;
	}

	.card-link-item {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-text-secondary);
		transition: color var(--transition-fast);
	}

	.project-card:hover .card-link-item {
		color: var(--color-text);
	}
	
	.project-card:hover .card-link-item.demo {
		color: var(--color-accent);
	}
</style>
